{
  "name": "media-scraper-service",
  "version": "1.0.0",
  "description": "Media scraper service built with NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "start:all": "pnpm start & pnpm start:worker",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn -- ./src/main.ts",
    "dev:worker": "ts-node-dev -r tsconfig-paths/register --respawn -- ./src/worker.ts",
    "dev:all": "pnpm dev & pnpm dev:worker",
    "debug": "ts-node-dev -r tsconfig-paths/register --respawn --inspect -- ./src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d src/config/database.config.ts",
    "migration:run": "pnpm typeorm migration:run -d src/config/database.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/typeorm": "^11.0.0",
    "bullmq": "^5.67.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "got-scraping": "^4.1.3",
    "pg": "^8.16.3",
    "playwright": "^1.58.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.4.0",
    "fastify": "^5.7.2",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.0"
  }
}
